# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# roborak: review state is per-machine; rules under .roborak/rules/ are not.
.roborak/state.json
.roborak/*.tmp

# The working config is per-checkout; .roborak.yaml.example is the tracked one.
.roborak.yaml
.roborak.yml

# Credentials. Forge tokens come from the environment; API keys may also sit in
# .roborak.yaml, which is one more reason that file is ignored above.
.env
.env.*
!.env.example

# Docs website (docs/): Node deps and the Vite build. The build is produced by
# Cloudflare Pages from source, so it is never committed.
node_modules/
docs/dist/
docs/.vite/

# Test and type-check caches
.coverage
.coverage.*
coverage.xml
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
eval-results.json
evals/eval-results.json

# Editor and OS cruft
.idea/
.vscode/
.DS_Store

# Copied out of node_modules by docs/scripts/copy-fonts.mjs at build time.
docs/public/fonts/
