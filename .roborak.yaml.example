# Copy to .roborak.yaml and edit. Every key is optional; defaults are shown.
version: 1

llm:
  model: anthropic/claude-sonnet-5
  # Tried in order if the primary model fails.
  fallback_models: []
  temperature: 0.2
  max_tokens: 8000
  # Prompt token ceiling. Omit to derive it from the model's context window.
  context_budget: null
  # Per-provider API keys, overriding the provider's environment variable. These
  # are real secrets: keep this file out of version control, or put them in
  # ~/.config/roborak/config.yaml instead. `roborak config show` redacts them.
  api_keys: {}
  #   anthropic: sk-ant-...
  #   openai: sk-...
  # Endpoint override for every call: an OpenAI-compatible proxy, an Azure
  # deployment, or a local Ollama. Setting it skips the missing-key check.
  api_base: null

review:
  categories: [security, bug, performance, logic]
  # Findings below this are not reported.
  severity_floor: minor
  max_findings: 25
  # Emit exact replacement code the reviewer can commit as-is.
  committable_suggestions: true
  # Drop findings the model was not reasonably sure about.
  min_confidence: 0.5
  # Allow findings on lines this change did not touch. Off by default: untouched
  # code is not what the author asked about, and it is the main source of noise.
  full_file: false

static:
  enabled: true
  # null autodetects whatever is on PATH.
  tools: null
  timeout_seconds: 90
  # Pass static findings to the model as evidence rather than reporting them raw.
  feed_to_llm: true

ignore_paths:
  - "**/*.lock"
  - "**/*.min.js"
  - "**/vendor/**"
  - "**/node_modules/**"
  - "**/dist/**"

rules_dir: .roborak/rules

# Extra prompt guidance per language, for stack-specific conventions.
language_instructions: {}
  # php: "Laravel 10 with the repository pattern; controllers stay thin."
